{
  "name": "takar-mcp",
  "version": "0.5.0",
  "description": "A second opinion for any Telegraph intent: two independent miners, chosen by an open on-chain record of who was right. Plus event resolution with verbatim quotes and a signed forecast scorecard. No key, no wallet.",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "telegraph",
    "prediction-markets",
    "event-resolution",
    "oracle",
    "forecasting"
  ],
  "homepage": "https://github.com/PugarHuda/takar/tree/main/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PugarHuda/takar.git",
    "directory": "mcp"
  },
  "bugs": "https://github.com/PugarHuda/takar/issues",
  "license": "MIT",
  "author": "Pugar Huda Mantoro",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "takar-mcp": "server.mjs"
  },
  "main": "server.mjs",
  "mcpName": "io.github.PugarHuda/takar",
  "files": [
    "server.mjs",
    "lib/",
    "README.md"
  ],
  "dependencies": {
    "ethers": "^6.13.0"
  },
  "scripts": {
    "prepack": "node -e \"const fs=require('fs');fs.mkdirSync('lib',{recursive:true});for(const f of ['second','telegraph','x402'])fs.copyFileSync('../lib/'+f+'.mjs','lib/'+f+'.mjs')\""
  }
}
